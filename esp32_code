// ================= LIBRARIES =================
#include <BluetoothSerial.h>
#include <TinyGPSPlus.h>
#include <HardwareSerial.h>

// ================= OBJECTS =================
BluetoothSerial SerialBT;
TinyGPSPlus gps;
HardwareSerial GPSSerial(1);

// ================= MOTOR PINS =================
int ENA = 22;
int IN1 = 18;
int IN2 = 19;
int ENB = 23;
int IN3 = 25;
int IN4 = 26;

// ================= ULTRASONIC =================
int trigPin = 5;
int echoPin = 21;

// ================= PWM =================
int channelA = 0;
int channelB = 1;
int freq = 5000;
int resolution = 8;
int speedValue = 200;

// ================= MOVEMENT CONTROL =================
unsigned long moveStartTime = 0;
bool movingForward = false;
int moveDuration = 2000; // forward distance control

// ================= TURN CONTROL =================
unsigned long turnStartTime = 0;
bool turning = false;
int turnDuration = 400; // adjust for ~90 degree
char turnDirection;

// ================= COMMAND =================
char command;

// ================= SETUP =================
void setup() {
    Serial.begin(115200);
    SerialBT.begin("NAVIO_BOT");
    GPSSerial.begin(9600, SERIAL_8N1, 16, 17);

    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);
    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);
    pinMode(trigPin, OUTPUT);
    pinMode(echoPin, INPUT);

    ledcSetup(channelA, freq, resolution);
    ledcAttachPin(ENA, channelA);

    ledcSetup(channelB, freq, resolution);
    ledcAttachPin(ENB, channelB);

    stopMotors();
}

// ================= LOOP =================
void loop() {

    // ================= GPS UPDATE =================
    while (GPSSerial.available()) {
        gps.encode(GPSSerial.read());
    }

    // ================= BLUETOOTH =================
    if (SerialBT.available()) {
        command = SerialBT.read();

        if (command == 'F') {
            forward();
            moveStartTime = millis();
            movingForward = true;
        }

        else if (command == 'B') {
            backward();
            movingForward = false;
        }

        else if (command == 'L') {
            turnLeft();
            turnStartTime = millis();
            turning = true;
            turnDirection = 'L';
        }

        else if (command == 'R') {
            turnRight();
            turnStartTime = millis();
            turning = true;
            turnDirection = 'R';
        }

        else if (command == 'S') {
            stopMotors();
            movingForward = false;
        }

        // speed control
        else if (command >= '0' && command <= '9') {
            speedValue = map(command - '0', 0, 9, 0, 255);
            ledcWrite(channelA, speedValue);
            ledcWrite(channelB, speedValue);
        }

        // GPS request
        else if (command == 'G') {
            sendGPS();
        }
    }

    // ================= AUTO STOP FOR FORWARD =================
    if (movingForward && millis() - moveStartTime >= moveDuration) {
        stopMotors();
        movingForward = false;
        SerialBT.println("Forward complete");
    }

    // ================= AUTO STOP FOR TURN =================
    if (turning && millis() - turnStartTime >= turnDuration) {
        stopMotors();
        turning = false;
        SerialBT.println("Turn complete");
    }

    // ================= OBSTACLE DETECTION =================
    int distance = getDistance();

    if (distance > 0 && distance < 20) {
        stopMotors();
        movingForward = false;
        turning = false;
        SerialBT.println("Obstacle!");
    }
}

// ================= FUNCTIONS =================

void sendGPS() {
    if (gps.location.isValid()) {
        float lat = gps.location.lat();
        float lng = gps.location.lng();

        SerialBT.print("LAT:");
        SerialBT.println(lat, 6);

        SerialBT.print("LNG:");
        SerialBT.println(lng, 6);

        SerialBT.print("MAP:https://maps.google.com/?q=");
        SerialBT.print(lat, 6);
        SerialBT.print(",");
        SerialBT.println(lng, 6);
    }
    else {
        SerialBT.println("GPS not fixed");
    }
}

int getDistance() {
    digitalWrite(trigPin, LOW);
    delayMicroseconds(2);

    digitalWrite(trigPin, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin, LOW);

    long duration = pulseIn(echoPin, HIGH, 30000);
    int distance = duration * 0.034 / 2;

    return distance;
}

// ================= MOTOR FUNCTIONS =================

void backward() {
    ledcWrite(channelA, speedValue);
    ledcWrite(channelB, speedValue);

    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
}

void forward() {
    ledcWrite(channelA, speedValue);
    ledcWrite(channelB, speedValue);

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
}

void turnLeft() {
    ledcWrite(channelA, speedValue);
    ledcWrite(channelB, speedValue);

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
}

void turnRight() {
    ledcWrite(channelA, speedValue);
    ledcWrite(channelB, speedValue);

    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
}

void stopMotors() {
    ledcWrite(channelA, 0);
    ledcWrite(channelB, 0);

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
}
